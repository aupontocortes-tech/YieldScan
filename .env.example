# NewsData.io — https://newsdata.io (nunca commite a chave real)
NEWSDATA_API_KEY=
# Opcional: idiomas da API (predefinido: pt,en). Ex.: pt
# NEWSDATA_LANGUAGES=pt
# MyMemory (tradução): opcional, duplica quota diária
# MYMEMORY_EMAIL=

# ── Twitter / X API v2 (Bearer Token no Developer Portal) ────────────────
# Sem token: o feed mostra só notícias NewsData; com token: mistura tweets filtrados.
# TWITTER_BEARER_TOKEN=
#
# Opcional: só tweets com filtro estrito (menos volume)
# TWITTER_STRICT_ONLY=1
#
# Lista completa de handles (sem @), substitui os defaults:
# TWITTER_USERNAMES=realDonaldTrump,DeItaone,WatcherGuru,ArthurReis
#
# Ou mantém defaults e acrescenta contas:
# TWITTER_EXTRA_USERNAMES=outraconta,maisuma
#
# Defaults: Trump | DeItaone (headlines estilo “Walter Bloomberg” — com “i”, NÃO escrever Deltaone) | Watcher.Guru | ArthurReis
