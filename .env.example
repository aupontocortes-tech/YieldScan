# GNews — https://gnews.io/ (notícias gerais PT; recomendado)
# GNEWS_API_KEY=

# NewsData.io — https://newsdata.io (nunca commite a chave real; fallback)
NEWSDATA_API_KEY=
# Opcional: idiomas da API (predefinido: en,pt para mais volume cripto). Ex.: pt,en
# NEWSDATA_LANGUAGES=en,pt
# MyMemory (tradução): opcional, duplica quota diária
# MYMEMORY_EMAIL=

# CryptoPanic — https://cryptopanic.com/developers/api/ (notícias cripto; funde com NewsData sem duplicar URL)
# CRYPTOPANIC_AUTH_TOKEN=
# (alias: CRYPTOPUNK_API_TOKEN — se usares outro nome por engano)
# Opcional: regiões ISO (predefinido: en). Ex.: en,pt
# CRYPTOPANIC_REGIONS=en
# Filtro: hot | rising | bullish | bearish | important | lol (predefinido: hot)
# CRYPTOPANIC_FILTER=hot

# Notícias — frequência de atualização (ver lib/news-refresh-config.ts)
# Servidor: cache Next + CDN (segundos). Mais baixo = mais chamadas às APIs GNews/NewsData/etc.
# NEWS_SERVER_REVALIDATE_SECONDS=10
# NEWS_CDN_STALE_WHILE_REVALIDATE_SECONDS=45
# Cliente (ms): polling TanStack Query + relógio "há X min" nos cartões
# NEXT_PUBLIC_NEWS_STALE_MS=8000
# NEXT_PUBLIC_NEWS_REFETCH_MS=10000
# NEXT_PUBLIC_NEWS_RELATIVE_CLOCK_MS=30000

# Carteira / Wallet: preços e pesquisa via CoinGecko (/api/prices, /api/cmc-search).
# CoinGecko (opcional mas recomendado): sem chave o limite público é baixo (erro 429).
# Demo (grátis): https://www.coingecko.com/en/api/pricing — cria chave e usa:
# COINGECKO_DEMO_API_KEY=
# Plano Pro:
# COINGECKO_PRO_API_KEY=

# Twitter / X: o projeto já NÃO usa esta API. Remove TWITTER_* na Vercel se ainda existir.

# --- Liquidity / Uniswap v3 (API server-side) ---
# Opcional: sem isto a app tenta vários RPCs públicos por rede (pode falhar com rate limit).
# Em produção (Vercel) recomenda-se um nó por cadeia, ex. Alchemy ou Infura.
# ETH_RPC_URL=https://...
# ARBITRUM_RPC_URL=https://...
# BASE_RPC_URL=https://...
# POLYGON_RPC_URL=https://...
# BSC_RPC_URL=https://...
# Alias aceites no browser/build: NEXT_PUBLIC_ETH_RPC_URL, NEXT_PUBLIC_BASE_RPC_URL, etc.
# Solana (liquidez API + wallet no browser)
# SOLANA_RPC_URL=https://...
# NEXT_PUBLIC_SOLANA_RPC_URL=https://...
